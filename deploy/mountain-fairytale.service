[Unit]
Description=Mountain Fairytale local API and PostgreSQL
Requires=docker.service mountain-fairytale-firewall.service
After=docker.service network-online.target mountain-fairytale-firewall.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mountain-fairytale
ExecStartPre=/usr/bin/test ! -f /opt/mountain-fairytale/.deploy/maintenance
ExecStart=/usr/bin/docker compose up -d --wait --wait-timeout 120 api
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
