# Server-only file. Generate secrets with scripts/deploy/init_env.py.
# Do not reuse the development .env or print docker compose config with secrets.
API_IMAGE=mountain-fairytale-api:1.0.0
# Apply the firewall service BEFORE publishing on all IPv4 interfaces.
API_BIND_HOST=0.0.0.0
API_PORT=8000
LAN_SUBNET=192.168.0.0/24
LAN_INTERFACE=eth0
# Host-level support tunnel, never passed to application containers.
SUPPORT_VPN_ENABLED=false
SUPPORT_VPN_PROTOCOL=sstp
SUPPORT_VPN_HOST=
SUPPORT_VPN_PORT=443
SUPPORT_VPN_USERNAME=
SUPPORT_VPN_PASSWORD=
SUPPORT_VPN_SUBNET=10.77.50.0/24
SUPPORT_VPN_EXPECTED_IP=10.77.50.11
SUPPORT_VPN_ADMIN_IP=10.77.50.10
SUPPORT_VPN_INTERFACE=support0
POSTGRES_DB=mountain_fairytale
POSTGRES_USER=mountain_fairytale
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: map/geocoding functions need this key, the API can start without it.
GEOAPIFY_API_KEY=
GEOAPIFY_TILE_CACHE_MAX_BYTES=2147483648
# Error reporting is optional; empty DSN disables backend reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
FLUTTER_MONITORING_ENABLED=false
FLUTTER_SENTRY_PUBLIC_KEY=
FLUTTER_SENTRY_PROJECT_ID=
# Host-side disk/backup checks; configure_monitoring_events fills this from GlitchTip.
OPERATIONS_SENTRY_DSN=
