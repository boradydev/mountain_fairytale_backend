[Unit]
Description=Restrict Mountain Fairytale API to LAN and authorized support VPN
Requires=docker.service
After=docker.service network-online.target
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/opt/mountain-fairytale/.env
ExecStart=/bin/sh /opt/mountain-fairytale/scripts/deploy/lan_firewall.sh
ExecReload=/bin/sh /opt/mountain-fairytale/scripts/deploy/lan_firewall.sh

[Install]
WantedBy=multi-user.target
