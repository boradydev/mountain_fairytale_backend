# Local Python/IDE launch. Copy to .env and fill the local secrets.
# Server deployment uses deploy/.env.example instead.

# HTTP
APP_HOST=0.0.0.0
APP_PORT=8000

# Local PostgreSQL: manual application data
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-postgres-password
POSTGRES_DB=mountain_fairytale_sales_live_20261101

# Disposable databases. Tests select their own DB; never use manual data here.
# Custom names must end in _test. Create these databases before the first run.
POSTGRES_API_TEST_DB=mountain_fairytale_api_test
POSTGRES_REPO_TEST_DB=mountain_fairytale_repo_test
CONFIG_DIR=.

# Authentication: keep existing local secrets when updating .env.
JWT_SECRET_KEY=replace-with-a-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=90
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-local-admin-password

# Maps: optional API key; blank disables requests requiring Geoapify.
GEOAPIFY_API_KEY=
GEOAPIFY_TILE_CACHE_DIR=.cache/geoapify-tiles
GEOAPIFY_TILE_CACHE_MAX_BYTES=21474836480

# Local monitoring: reporting disabled until explicitly configured.
SENTRY_ENVIRONMENT=development
SENTRY_DSN=
FLUTTER_MONITORING_ENABLED=false
FLUTTER_SENTRY_PUBLIC_KEY=
FLUTTER_SENTRY_PROJECT_ID=
GLITCHTIP_PORT=8080
